# ======================= 核心服务 ======================
OVERSTATS_API_HOST=0.0.0.0
OVERSTATS_API_PORT=18080
OVERSTATS_USE_STREAM_RESPONSE=true
OVERSTATS_ENABLE_DATABASE_WRITE=true
OVERSTATS_DASHEN_MAX_CONCURRENT_REQUESTS=2
OVERSTATS_DASHEN_MAX_ACCEPTED_REQUESTS=4

# ======================= 网易大神账号（JSON 数组，替换成你自己的） ======================
OVERSTATS_DASHEN_ACCOUNTS_JSON=[{"name":"account-1","role_id":你的role_id,"token":"你的token"}]

# ======================= OW 赛事 API（PandaScore） ======================
OVERSTATS_OW_ESPORTS_API_KEY=你的pandascore_api_key

# ======================= LLM AI 分析（OpenAI 兼容） ======================
OVERSTATS_ANALYSIS_BASE_URL=https://api.moonshot.cn/v1/chat/completions
OVERSTATS_ANALYSIS_API_KEY=你的api_key
